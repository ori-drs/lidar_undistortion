<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="rviz" default="true" />
  <arg name="load_ouster_model" default="false" />
  <arg name="simulation" default="false" />

  <include file="$(find lidar_undistortion_ros)/launch/os_undistortion.launch">
    <arg name="ouster_config_file" default="$(find lidar_undistortion)/config/os1_64_gen1_fw_114_sn_991924000158.json" />
    <arg name="rviz" value="$(arg rviz)" />
    <arg name="load_ouster_model" default="$(arg load_ouster_model)" />
    <arg name="simulation" value="$(arg simulation)" />
  </include>
</launch>

