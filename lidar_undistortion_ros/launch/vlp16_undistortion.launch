<?xml version="1.0" encoding="UTF-8"?>
<launch>
    <node name="velodyne_undistortion" pkg="lidar_undistortion_ros" type="velodyne_undistortion_node" output="screen">
        <param name="pose_topic" value="/state_estimator/pose_in_odom" />
        <param name="base_frame_id" value="base" />
        <param name="odom_frame_id" value="odom" />
        <param name="lidar_frame_id" value="lidar" />
        <param name="velodyne_calibration_file" value="$(find lidar_undistortion)/config/VLP16db_example.yaml" />
    </node>
    <node name="velodyne_rviz" pkg="rviz" type="rviz" args="-d $(find lidar_undistortion_ros)/config/velodyne_undistortion.rviz" output="log" />
</launch>
